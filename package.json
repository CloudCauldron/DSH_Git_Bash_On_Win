{
  "name": "dsh-git-bash-on-win",
  "version": "0.1.0-experimental.1",
  "private": true,
  "type": "module",
  "description": "Process-local Git Bash compatibility for DSH's Windows sandbox.",
  "main": "./lib/adapter.js",
  "types": "./lib/adapter.d.ts",
  "exports": {
    ".": { "types": "./lib/adapter.d.ts", "default": "./lib/adapter.js" },
    "./executor": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./preset": { "types": "./lib/preset.d.ts", "default": "./lib/preset.js" },
    "./tool": "./lib/tool.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml", "platforms": ["win32"] },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": { "node": ">=26", "dsh": "0.2.2-rc.2" },
  "scripts": {
    "lint": "eslint src scripts test eslint.config.mjs --max-warnings 0",
    "check": "tsc --noEmit",
    "build": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('lib', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "test": "pnpm build && node --test test/*.test.ts",
    "test:browser": "pnpm build && node --test test/client-browser.ts",
    "test:windows": "node -e \"if (process.platform !== 'win32' || process.arch !== 'x64') throw new Error('Native Windows x64 Node is required.');\" && pnpm test",
    "test:release": "node --input-type=module -e \"import { installedDsh } from './scripts/installed-dsh.ts'; import { discoverGitInstallation } from './src/runtime/git-installation.ts'; installedDsh(); discoverGitInstallation(process.env.DSH_TEST_GIT_BASH);\" && pnpm check && pnpm lint && pnpm test:windows"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-win32-process": "0.2.2-rc.2",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.2-rc.2",
    "@deepseek-ai/dsh-win32-process": "0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-test-renderer": "18.3.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "yaml": "2.9.1"
  }
}
